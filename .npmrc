auto-install-peers=false
strict-peer-dependencies=false

# Hoist these packages to root node_modules so that `tsc --build`
# can resolve them when compiling lib/ project references on Render CI.
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=zod
public-hoist-pattern[]=@types/node
public-hoist-pattern[]=drizzle-orm
public-hoist-pattern[]=pg
