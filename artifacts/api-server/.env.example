# SKA Fintech API Server — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

PORT=5001
NODE_ENV=development
# Use Supabase Pooler connection string (port 6543, Transaction mode) for production app runtime.
# Direct host (port 5432, db.YOUR_REF.supabase.co) is IPv6-only and causes connection timeouts on IPv4 hosts like Render.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD_HERE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DB_POOL_MAX=10
DATABASE_SSL=true
JWT_SECRET=GENERATE_A_RANDOM_64_CHAR_SECRET_HERE
